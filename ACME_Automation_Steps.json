  "home_directories": [
    { "user": "SecTest", "drive_letter": "H", "path": "\\\\AcmePDC01\\Users$\\SecTest" }
  ],

  "dhcp": {
    "scope_name": "AcmeBusiness",
    "start_ip": "192.168.4.100", "end_ip": "192.168.4.249",
