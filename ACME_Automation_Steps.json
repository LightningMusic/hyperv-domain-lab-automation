  "shared_folders": [
    { "name": "Users$", "path": "E:\\Users$",  "share_permissions": "Everyone:FullControl" },
    { "name": "PUB",    "path": "E:\\PUB",     "share_permissions": "Everyone:Read" },
    { "name": "APPS",   "path": "E:\\APPS",    "share_permissions": "Everyone:FullControl" }
